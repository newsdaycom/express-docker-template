# Purpose:
#   Safe local environment example for services generated from this template.
#
# Operational Notes:
#   Local Redis may use an insecure redis:// URL. Stage and production should
#   provide secure rediss:// Valkey URLs through deployment-managed secrets.

ENV=local
BUILD_VERSION=local-build
NODE_ENV=local
NODE_OPTIONS=--enable-source-maps
LOG_LEVEL=info
LOG_PRETTY=on

# Redis Streams / Valkey
REDIS_URL=redis://redis:6379
REDIS_STREAM_PREFIX=local
REDIS_CONSUMER_GROUP=example-service
REDIS_CONSUMER_NAME=example-service-local
REDIS_BLOCK_MS=5000
REDIS_BATCH_SIZE=10
REDIS_PENDING_IDLE_MS=60000
REDIS_SCHEDULED_SET=local:scheduled-jobs
